{
   "name": "cancrexo/sjboverrides",
   "description": "Plugin gestion overrides en prestashop",
   "authors": [
       {
           "name": "cancrexo",
           "email": "cancrexo@gmail.com"
       }
   ],
   "require": {
       "php": ">=7.3.0"
   },
   "autoload": {
       "psr-4": {
           "Sjboverrides\\": "src/"
       },
       "classmap": [
           "classes/"
       ],
       "exclude-from-classmap": []
   },
   "config": {
       "preferred-install": "dist",
       "prepend-autoloader": false
   },
   "type": "prestashop-module",
   "author": "Daniel cancrexo Prol",
   "license": "MIT"
}